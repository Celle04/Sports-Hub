APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match how the app is actually reached from the browser, including any
# subfolder. Uploaded profile photos are served from APP_URL/storage, so a
# wrong value here makes every avatar a broken image.
APP_URL=http://localhost/SportsHub/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportshub
DB_USERNAME=root
# Leave empty for the default XAMPP install. Never commit a real password here.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail - password reset emails (Gmail SMTP)
#
# Password reset links are delivered with the transport below. To use Gmail:
#   MAIL_USERNAME     = the Gmail address that sends SportsHub mail
#   MAIL_PASSWORD     = a 16-character Google App Password, NOT the Gmail
#                       password (https://myaccount.google.com/apppasswords,
#                       requires Google 2-Step Verification)
#   MAIL_FROM_ADDRESS = the same Gmail address (must match the user)
#
# Laravel 12 accepts only MAIL_SCHEME=smtp (STARTTLS on port 587, the normal
# Gmail choice) or MAIL_SCHEME=smtps (implicit TLS on port 465). Scheme "tls"
# is not a valid scheme and will be rejected. MAIL_ENCRYPTION is informational
# here; STARTTLS is negotiated automatically via MAIL_AUTO_TLS (default true).
#
# Never commit a real password here. Afterwards run:  php artisan config:clear
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SNNHS SportsHub"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila
