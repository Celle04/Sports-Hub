APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match how the app is actually reached from the browser, including any
# subfolder. Uploaded profile photos are served from APP_URL/storage, so a
# wrong value here makes every avatar a broken image.
APP_URL=http://localhost/SportsHub/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportshub
DB_USERNAME=root
# Leave empty for the default XAMPP install. Never commit a real password here.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail â€” password reset emails
#
# "log" writes reset links to storage/logs/laravel.log. For real delivery set
# MAIL_MAILER=smtp, MAIL_SCHEME=tls (587) / ssl (465), and fill in your mail
# provider's host/port/username/password. Never commit a real password here.
# MAIL_FROM_ADDRESS should be the account/domain you actually send from.
# Afterwards run:  php artisan config:clear
# ---------------------------------------------------------------------------
# Mail delivery: Gmail SMTP. Fill in YOUR Gmail address (MAIL_USERNAME) and a
# 16-character Google App Password (MAIL_PASSWORD), then run: php artisan config:clear
# Generate an App Password here (requires Google 2-Step Verification):
# https://myaccount.google.com/apppasswords
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SNNHS SportsHub"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila
