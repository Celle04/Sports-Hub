<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Same as phpunit.xml, except the whole suite runs against a real
             MySQL/MariaDB server so driver compatibility is actually proven.
             Only a scratch database may be used: tests/TestCase.php refuses to
             run against a database whose name is not clearly disposable. -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing.php"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/events.testing.php"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes.testing.php"/>
        <env name="APP_PACKAGES_CACHE" value="bootstrap/cache/packages.testing.php"/>
        <env name="APP_SERVICES_CACHE" value="bootstrap/cache/services.testing.php"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="sportshub_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>